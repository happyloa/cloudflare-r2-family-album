{
  "name": "family-album",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261006.1": true
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "dev:worker": "vite dev --port 3001",
    "build": "vite build",
    "build:worker": "npm run build",
    "start": "node scripts/start-worker.mjs",
    "deploy": "vinext-cloudflare deploy",
    "deploy:dry-run": "npm run build && vinext-cloudflare deploy --dry-run && wrangler deploy --config dist/server/wrangler.json --dry-run",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv",
    "check:vinext": "vinext check",
    "typecheck": "vinext typegen && tsc --noEmit",
    "test": "vitest --config vitest.config.mts",
    "test:run": "vitest run --config vitest.config.mts",
    "test:e2e": "playwright test",
    "test:e2e:worker": "node scripts/test-worker.mjs",
    "verify": "npm run cf-typegen && npm run check:vinext && npm run typecheck && npm run test:run && npm run build"
  },
  "dependencies": {
    "@fontsource/noto-sans-tc": "^5.3.1",
    "@vinext/cloudflare": "^1.1.0",
    "aws4fetch": "^1.0.20",
    "fast-xml-parser": "^5.11.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-server-dom-webpack": "^19.3.0",
    "vinext": "^1.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.2",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.37",
    "fast-glob": "file:./vendor/dynamic-import-glob",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wrangler": "^4.150.0"
  },
  "overrides": {
    "postcss": "$postcss",
    "satori": {
      "fflate": "0.7.5"
    },
    "fast-glob": "$fast-glob"
  }
}
