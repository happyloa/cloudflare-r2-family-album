{
  "name": "family-album",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261117.1": true,
    "workerd@1.20261118.1": true
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "dev:worker": "vite dev --port 3001",
    "build": "vite build",
    "build:worker": "npm run build",
    "start": "node scripts/start-worker.mjs",
    "deploy": "vinext-cloudflare deploy",
    "deploy:dry-run": "npm run build && vinext-cloudflare deploy --dry-run && wrangler deploy --config dist/server/wrangler.json --dry-run",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv",
    "check:vinext": "vinext check",
    "typecheck": "npm run cf-typegen && vinext typegen && tsc --noEmit",
    "test": "vitest --config vitest.config.mts",
    "test:run": "vitest run --config vitest.config.mts",
    "test:e2e": "playwright test",
    "test:e2e:worker": "node scripts/test-worker.mjs",
    "test:trash:worker": "node scripts/test-trash-worker.mjs",
    "test:mutations:worker": "node scripts/test-mutations-worker.mjs",
    "verify": "npm run check:vinext && npm run typecheck && npm run test:run && npm run build && npm run test:trash:worker && npm run test:mutations:worker"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-tc": "^5.3.1",
    "@vinext/cloudflare": "^1.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "vinext": "^1.4.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.165.0"
  },
  "overrides": {
    "postcss": "$postcss",
    "satori": {
      "fflate": "0.7.5"
    }
  }
}
