# ── 必填 ──
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=family-album
# 公開讀取網址：R2 的 pub-xxxx.r2.dev 網域，或已綁定的自訂網域（例如 https://photos.example.com）。
# 注意：不是 <bucket>.<account>.r2.cloudflarestorage.com 這個 S3 API 端點，那個需要簽名才能存取，瀏覽器直接打會 403。
R2_PUBLIC_BASE=https://pub-xxxxxxxxxxxxxxxx.r2.dev
ADMIN_ACCESS_TOKEN=your_admin_password

# ── 選用（皆有預設值，可不填）──
# 密碼錯誤次數上限（預設 5 次 / 5 分鐘）
# ADMIN_RATE_LIMIT_MAX_FAILURES=5
# 圖片單檔上限 MB（預設 10，最高 32）。只在 Worker runtime 讀取；管理介面會向受保護 API 取得實際限制。
# MAX_IMAGE_SIZE_MB=10
# 影片單檔上限 MB（預設與最高皆為 32）；單一批次總容量同樣最高 32 MB，最多 20 個檔案。
# MAX_VIDEO_SIZE_MB=32
# 請勿設定 NEXT_PUBLIC_MAX_*：它們不再被使用。
